{
  "name": "WishlistBottle",
  "type": "object",
  "properties": {
    "distillery": {
      "type": "string",
      "description": "Name of the distillery"
    },
    "bottle_name": {
      "type": "string",
      "description": "Name of the bottle"
    },
    "estimated_price": {
      "type": "number",
      "description": "Estimated price"
    },
    "priority": {
      "type": "string",
      "enum": [
        "Low",
        "Medium",
        "High"
      ],
      "default": "Medium",
      "description": "Priority level"
    },
    "notes": {
      "type": "string",
      "description": "Notes about why this bottle is desired"
    }
  },
  "required": [
    "bottle_name"
  ]
}